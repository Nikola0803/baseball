# Stripe — server-side only. NEVER commit real values; set these in the
# Vercel dashboard (Project → Settings → Environment Variables).
# Use your LIVE secret/restricted key (sk_live_... or rk_live_...).
# A restricted key needs the "Checkout Sessions: write" permission.
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: force the base URL used for Stripe success/cancel redirects.
# Leave unset to auto-detect from the incoming request host.
# PUBLIC_SITE_URL=https://your-domain.com
